{
  "cli": {
    "version": ">= 5.0.0",
    "promptToConfigurePushNotifications": false,
    "packageManager": "npm"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease",
        "enableProguard": true,
        "withoutCredentials": false,
        "env": {
          "GRADLE_OPTS": "-Dorg.gradle.jvmargs='-Xmx2048m'"
        },
        "extraBuildGradle": "dependencies {\n  implementation 'com.android.billingclient:billing:9.1.0'\n}\n\nandroid {\n  buildTypes {\n    release {\n      minifyEnabled true\n      shrinkResources true\n      proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'\n    }\n  }\n}"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
